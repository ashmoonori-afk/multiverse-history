{
  "name": "multiverse-history",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --watch src/api/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "start:api": "bun src/api/server.ts",
    "api:test-fixtures": "bun src/cli/api-test-fixtures.ts",
    "providers:diagnose": "bun src/cli/providers-diagnose.ts",
    "providers:smoke": "bun src/cli/providers-smoke.ts",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/application tests/api tests/domain tests/integration tests/persistence tests/providers tests/shared tests/web",
    "test:e2e": "playwright test",
    "build": "bun run build:api && bun run build:web",
    "build:api": "bun build src/api/server.ts --outdir dist/api --target bun",
    "build:web": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "^5.2.8",
    "@fontsource-variable/noto-serif-kr": "^5.2.8",
    "hono": "^4.9.6",
    "i18n-iso-countries": "^7.14.0",
    "maplibre-gl": "^5.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "^8.1.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.21",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "react-doctor": "^0.9.12",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
